# ============================================================================
# Application
# ============================================================================
NODE_ENV=development
PORT=3000
APP_NAME=pedidos-delivery-backend

# ============================================================================
# Database - Selecciona el origen con USE_LOCAL_DB
# ============================================================================
# true  → usa Postgres local (Docker)
# false → usa Supabase (nube)
USE_LOCAL_DB=false

# --- Local (Docker) ---
# Cuando USE_LOCAL_DB=true, DIRECT_URL debe apuntar a la misma DB local
# (Prisma Migrate lo necesita para conexiones directas sin pooler)
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pedidos_delivery?schema=public

# --- Supabase (nube) ---
# 1. Crear proyecto en https://supabase.com
# 2. Settings → Database → Connection string
# 3. Copiar:
#    - Transaction (puerto 6543, pooler) → DATABASE_URL
#    - Session    (puerto 5432, directo)  → DIRECT_URL
# 4. Reemplazar [YOUR-PASSWORD] con tu password
#
# Ejemplo:
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# En modo Local (USE_LOCAL_DB=true), DIRECT_URL puede quedar vacío:
# el wizard lo setea automáticamente a LOCAL_DATABASE_URL.
DATABASE_URL=
DIRECT_URL=

# ============================================================================
# JWT
# ============================================================================
JWT_SECRET=change-this-super-secret-key-in-production-min-10-chars
# Vida corta: el access token se renueva vía /auth/refresh, no depende de este valor
JWT_EXPIRES_IN=15m
# Vida del refresh token (días) antes de expirar y requerir login de nuevo
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ============================================================================
# Bcrypt
# ============================================================================
BCRYPT_SALT_ROUNDS=10

# ============================================================================
# Rate limiting (POST /auth/login)
# ============================================================================
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# Seed (solo dev)
# ============================================================================
SEED_ADMIN_EMAIL=admin@pedidos.local
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=00000000
SEED_ADMIN_PASSWORD=Admin123!
